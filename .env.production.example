# PRODUCTION: public Vite settings only. NO TEST project values.
# Deploy the organizer portal to its OWN repository/domain, not the educational main website.
VITE_DEPLOYMENT_STAGE=production
# Use / for a dedicated custom-domain/root GitHub Pages site; /repo-name/ for a project page.
VITE_BASE_PATH=/
VITE_STYTCH_PUBLIC_TOKEN=public-token-live-REPLACE_WITH_STYTCH_LIVE_PUBLIC_TOKEN
VITE_STYTCH_ORGANIZATION_ID=organization-live-REPLACE_WITH_LIVE_ORGANIZATION_ID
VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PRODUCTION_PUBLISHABLE_KEY
