# DOCUMENTATION ONLY - do not upload this file with real values or commit filled copies.
# Put values in the matching STAGING or PRODUCTION Supabase project Edge Function Secrets.
# Supabase automatically provides SUPABASE_URL and some platform API keys: do NOT attempt
# to create custom secret names starting SUPABASE_ (reserved); read injected values in functions.
# Each environment has a separate secret set, production values are NOT copied from staging.

PORTAL_ENVIRONMENT=production
PORTAL_ORIGIN=https://YOUR_PORTAL_PRODUCTION_HOST
PORTAL_ISSUER=https://YOUR_PORTAL_PRODUCTION_HOST
PORTAL_IDENTITY_PEPPER=REPLACE_WITH_SEPARATELY_GENERATED_RANDOM_SECRET
PORTAL_JWT_PRIVATE_JWK=REPLACE_WITH_PRODUCTION_PRIVATE_JWK_MATCHING_SUPABASE_SIGNING_KEY

STYTCH_API_BASE=https://api.stytch.com
STYTCH_PROJECT_ID=project-live-REPLACE
STYTCH_SECRET=REPLACE_WITH_STYTCH_LIVE_SECRET
STYTCH_ORGANIZATION_ID=organization-live-REPLACE

# Only for the public volunteer application function, if/when it is ready to launch.
TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SERVER_SECRET
PORTAL_HOSTNAME=YOUR_PORTAL_PRODUCTION_HOST

OPENAI_API_KEY=REPLACE_WITH_PRIVATE_OPENAI_KEY
OPENAI_CHAT_MODEL=gpt-4.1-mini
BUFFER_API_KEY=REPLACE_WITH_BUFFER_API_KEY
BUFFER_ORGANIZATION_ID=REPLACE_WITH_BUFFER_ORG_ID
MONITOR_CRON_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
MONITOR_PORTAL_URL=https://YOUR_PORTAL_PRODUCTION_HOST/
MONITOR_ASTRO_URL=https://study0sg.github.io/
MONITOR_ALLOWED_HOSTS=YOUR_PORTAL_PRODUCTION_HOST,study0sg.github.io
MONITOR_ALLOWED_BROWSER_ORIGINS=

# Google Drive OAuth fields are a PLANNED integration: not consumed by current v1.7 functions.
# Production needs a Drive broker Edge Function that validates organizer roles and file IDs.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REFRESH_TOKEN=REPLACE_WITH_OWNER_GRANTED_REFRESH_TOKEN
GOOGLE_DRIVE_ROOT_FOLDER_ID=1fWUFyC0haFiM5XLbUsDkam6HFp7GjvWF
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# R2: only required if still using media-presign with Cloudflare R2.
R2_ACCOUNT_ID=REPLACE_IF_USING_R2
R2_ACCESS_KEY_ID=REPLACE_IF_USING_R2
R2_SECRET_ACCESS_KEY=REPLACE_IF_USING_R2
R2_BUCKET=REPLACE_IF_USING_R2

# PLANNED, not implemented by v1.7: GitHub App-based departmental publishing.
# Keep the app's private key out of the source tree and Edge runtime until the broker exists.
GITHUB_APP_ID=REPLACE_AFTER_GITHUB_APP_REVIEW
GITHUB_APP_INSTALLATION_ID=REPLACE_AFTER_GITHUB_APP_INSTALL
GITHUB_APP_PRIVATE_KEY=REPLACE_WITH_PEM_IN_SECRET_MANAGER_ONLY
